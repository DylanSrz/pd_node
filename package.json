{
  "name": "pd_node",
  "version": "1.0.0",
  "description": "Repository for the performance test of the Node.js advanced track",
  "main": "dist/app.js",
  "scripts": {
    "dev": "npx tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "migrate": "tsx src/config/migrate-up.ts",
    "migrate:reverse": "tsx src/config/migrate-down.ts",
    "migrate:reset": "tsx src/config/migrate-reset.ts",
    "seed": "tsx src/config/seeders-up.ts",
    "seed:down": "tsx src/config/seeders-down.ts",
    "seed:reset": "tsx src/config/seeders-reset.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DylanSrz/pd_node.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DylanSrz/pd_node/issues"
  },
  "homepage": "https://github.com/DylanSrz/pd_node#readme",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "zod": "^4.5.4"
  }
}
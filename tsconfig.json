{
  "compilerOptions": {
    // Folder where the TypeScript source code lives.
    "rootDir": "./src",

    // Folder where the code compiled to JavaScript ends up.
    "outDir": "./dist",

    // Modern Node module system (import / export).
    "module": "nodenext",

    // JavaScript version that is generated.
    "target": "esnext",

    // Global types that are loaded. We need the Node ones
    // in order to use process.env, __dirname, etc.
    "types": ["node"],

    // Generates the .map files so debugging is possible.
    "sourceMap": true,

    // Generates the .d.ts declaration files.
    "declaration": true,
    "declarationMap": true,

    // Turns on every strict check of TypeScript.
    "strict": true,

    // Forces writing "import type" when only a type is imported.
    "verbatimModuleSyntax": true,

    // Each file is compiled separately.
    "isolatedModules": true,

    // Treats every file as a module.
    "moduleDetection": "force",

    // Does not check the types of the node_modules libraries
    // (it compiles much faster).
    "skipLibCheck": true,

    // Warns if a side-effect-only import does not exist.
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts"]
}

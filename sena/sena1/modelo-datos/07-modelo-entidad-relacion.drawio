<mxfile host="app.diagrams.net" agent="RiwiMediCare Plus" version="24.7.17" type="device">
  <diagram name="Modelo entidad-relacion" id="der-riwi">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="MODELO ENTIDAD - RELACION&#10;Base de datos db_nodejs  -  API RiwiMediCare Plus" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#2d8400;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="620" height="55" as="geometry" />
        </mxCell>
        <mxCell id="leyenda" value="LEYENDA&#10;&#10;PK   llave primaria&#10;FK   llave foranea&#10;U    restriccion de unicidad&#10;&#10;1 : N   uno a muchos&#10;&#10;Notacion de pata de gallo:&#10;el extremo con una sola linea&#10;indica  uno,  el extremo con&#10;tres lineas indica  muchos." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f6f8f5;strokeColor=#d8ddd6;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="restr" value="RESTRICCIONES DECLARADAS EN LA BASE DE DATOS&#10;&#10;users&#10;   UNIQUE (email)&#10;   ENUM enum_users_role : administrador | gestor&#10;&#10;clinicas&#10;   UNIQUE (nit)&#10;&#10;inventario&#10;   FK almacen_id      -&gt;  almacenes(id)&#10;   FK medicamento_id  -&gt;  medicamentos(id)&#10;   UNIQUE (almacen_id, medicamento_id)&#10;      inventario_almacen_medicamento_unico&#10;   CHECK (cantidad &gt;= 0)&#10;      inventario_cantidad_no_negativa&#10;&#10;solicitudes&#10;   FK clinica_id      -&gt;  clinicas(id)&#10;   FK medicamento_id  -&gt;  medicamentos(id)&#10;   FK almacen_id      -&gt;  almacenes(id)&#10;   FK usuario_id      -&gt;  users(id)&#10;   CHECK (cantidad_solicitada &gt; 0)&#10;      solicitudes_cantidad_mayor_a_cero&#10;   ENUM enum_solicitudes_estado :&#10;      pendiente | aprobada | rechazada&#10;      entregada | cancelada" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#fdf4ea;strokeColor=#c25e00;spacing=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="360" y="760" width="420" height="440" as="geometry" />
        </mxCell>
        <mxCell id="notaNM" value="RELACION MUCHOS A MUCHOS&#10;&#10;almacenes  &lt;--&gt;  medicamentos&#10;&#10;Un almacen guarda muchos medicamentos&#10;y un medicamento esta en muchos almacenes.&#10;&#10;La relacion se resuelve con la tabla&#10;intermedia  inventario,  que ademas aporta&#10;el atributo propio  cantidad.&#10;&#10;La restriccion UNIQUE (almacen_id,&#10;medicamento_id) garantiza que un almacen&#10;no pueda tener dos filas del mismo&#10;medicamento." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#fff8e0;strokeColor=#c9a227;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="800" width="330" height="250" as="geometry" />
        </mxCell>
        <mxCell id="notaBaja" value="ELIMINACION LOGICA&#10;&#10;Ninguna tabla se borra fisicamente.&#10;Todas incluyen  is_active BOOLEAN.&#10;&#10;El DELETE de la API cambia ese campo&#10;a false: el registro desaparece de los&#10;listados operativos pero se conserva&#10;para el historial." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#eaf6e3;strokeColor=#39A900;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="800" width="300" height="170" as="geometry" />
        </mxCell>

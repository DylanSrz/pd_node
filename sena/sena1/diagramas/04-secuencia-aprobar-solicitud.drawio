          </mxGeometry>
        </mxCell>
        <mxCell id="m15" value="update({ cantidad: 500 - 120 })" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="750" y="780" as="sourcePoint" /><mxPoint x="1070" y="780" as="targetPoint" /></mxGeometry>

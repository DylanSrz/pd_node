        <mxCell id="m18" value="commit()" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="750" y="930" as="sourcePoint" /><mxPoint x="910" y="930" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m19" value="COMMIT   &#8592; libera el bloqueo de la fila" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;fontStyle=1;strokeColor=#2d8400;fontColor=#2d8400;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="910" y="966" as="sourcePoint" /><mxPoint x="1230" y="966" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m20" value="solicitud actualizada con sus relaciones" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="750" y="1006" as="sourcePoint" /><mxPoint x="590" y="1006" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m21" value="200 OK  { message, solicitud }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=11;fontStyle=1;strokeColor=#2d8400;fontColor=#2d8400;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="1046" as="sourcePoint" /><mxPoint x="110" y="1046" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="notaLock" value="POR QUE EL BLOQUEO DE FILA&#10;&#10;Sin  FOR UPDATE,  dos aprobaciones&#10;simultaneas del mismo medicamento&#10;leerian ambas  cantidad = 500,  ambas&#10;la considerarian suficiente y ambas&#10;descontarian sobre el mismo valor:&#10;&#10;   T1 lee 500  ->  escribe 380&#10;   T2 lee 500  ->  escribe 380&#10;&#10;Resultado: se comprometen 240 unidades&#10;pero el inventario solo bajo 120.&#10;&#10;Con el bloqueo, T2 espera a que T1&#10;confirme y entonces lee 380, el valor&#10;real, y revalida sobre el.&#10;&#10;   T1 lee 500  ->  escribe 380  COMMIT&#10;   T2 espera... lee 380  ->  revalida" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#fbe6e5;strokeColor=#b3261e;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1350" y="150" width="280" height="330" as="geometry" />
        </mxCell>

        <mxCell id="notaRollback" value="MANEJO DEL ERROR&#10;&#10;Si cualquier paso dentro de la&#10;transaccion falla, el bloque catch&#10;ejecuta  rollback()  y relanza el&#10;error hacia el manejador central.&#10;&#10;Nunca queda el estado cambiado con&#10;el inventario sin ajustar, ni al&#10;reves: se aplican los dos cambios&#10;o no se aplica ninguno.&#10;&#10;Casos que provocan rollback:&#10;&#10;  400  el almacen ya no maneja&#10;       ese medicamento&#10;  400  inventario insuficiente&#10;       en el momento de aprobar&#10;  404  la solicitud fue dada de&#10;       baja entre tanto" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#fdf4ea;strokeColor=#c25e00;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1350" y="510" width="280" height="320" as="geometry" />
        </mxCell>

        <mxCell id="notaOtras" value="OTRAS TRANSICIONES&#10;&#10;aprobada -&gt; cancelada&#10;   reintegra:  cantidad + solicitada&#10;&#10;aprobada -&gt; entregada&#10;   sin efecto sobre el inventario&#10;&#10;pendiente -&gt; rechazada / cancelada&#10;   sin efecto: nunca se descontó" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#eaf6e3;strokeColor=#39A900;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1350" y="860" width="280" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

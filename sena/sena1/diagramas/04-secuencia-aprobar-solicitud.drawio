        </mxCell>
        <mxCell id="m14" value="revalidar  cantidad &gt;= cantidad_solicitada" style="edgeStyle=orthogonalEdgeStyle;html=1;align=left;spacingLeft=6;endArrow=block;rounded=0;curved=0;fontSize=10;verticalAlign=bottom;" edge="1" parent="1">

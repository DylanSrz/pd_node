        <mxCell id="nota1" value="EFECTO SOBRE EL INVENTARIO&#10;&#10;pendiente  ->  aprobada&#10;   cantidad = cantidad - solicitada&#10;&#10;aprobada   ->  cancelada&#10;   cantidad = cantidad + solicitada&#10;&#10;aprobada   ->  entregada&#10;   sin efecto (ya se descontó)&#10;&#10;pendiente  ->  rechazada&#10;pendiente  ->  cancelada&#10;   sin efecto (nunca se descontó)&#10;&#10;baja logica de una aprobada&#10;   cantidad = cantidad + solicitada" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#f6f8f5;strokeColor=#d8ddd6;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1100" width="260" height="270" as="geometry" />
        </mxCell>

        <mxCell id="nota2" value="ESTADOS FINALES&#10;&#10;rechazada, entregada y cancelada&#10;no admiten ninguna transicion&#10;posterior. Cualquier intento se&#10;rechaza con 400 indicando que se&#10;trata de un estado final." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#fdf4ea;strokeColor=#c25e00;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="230" height="130" as="geometry" />
